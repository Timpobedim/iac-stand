# Сгенерировано Ansible ({{ release_image }}:{{ app_version }}). Руками не править: перезапишется при выкате.
{% if upstreams %}
upstream orders {
{% for name in upstreams %}
    server {{ name }}:8000 max_fails=1 fail_timeout=5s;
{% endfor %}
}
{% endif %}

server {
    listen 8080;
    server_tokens off;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
{% if upstreams %}
        proxy_pass http://orders;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        add_header X-Upstream $upstream_addr always;
{% else %}
        default_type text/plain;
        return 503 "no release deployed yet\n";
{% endif %}
    }
}
